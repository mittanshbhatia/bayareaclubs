# Public application origin, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase public browser configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=

# Optional Supabase Storage S3 interface (server integrations only).
# Never expose these to client code or NEXT_PUBLIC_ variables.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=us-west-2
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
